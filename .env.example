# Copy to .env in this folder. Used by testing.py and api_server.py
SERPER_API_KEY=your_serper_key
OPENAI_API_KEY=your_openai_key
# OpenAI chat model used for LLM verification (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Profile discovery workflow (profile_discovery.py) ──
# Step 6 — minimum LLM confidence to accept a profile (else NOT_FOUND).
# Lowered default (0.50) prefers likely matches over excessive NOT_FOUND.
PROFILE_MATCH_THRESHOLD=0.50
# Step 4 — number of candidate URLs handed to the LLM per platform (top-N as
# returned by Serper; no ranking/scoring applied).
MAX_CANDIDATES_FOR_LLM=4
# Step 4 — keep only links on the platform's own domain (1=on, 0=raw top-N).
RESTRICT_CANDIDATE_HOSTS=1
# Serper organic results requested per query
SERPER_RESULTS_PER_QUERY=10
# Retry counts for transient Serper / LLM failures
SERPER_MAX_RETRIES=3
LLM_MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
# Optional JSON override for platform filters, e.g.
# PLATFORM_FILTERS_JSON={"Facebook": {"allowed_hosts": ["facebook.com"]}}
# PLATFORM_FILTERS_JSON=

# Comma-separated frontend origins for production CORS
# Example: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
