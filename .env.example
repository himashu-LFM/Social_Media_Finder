# Copy to .env in this folder. Used by api_server.py and the verification services.

# ── LLM verification (OpenAI Chat Completions) ──
OPENAI_API_KEY=your_openai_key
# Optional: defaults to gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── Apify Social Media Finder actor ──
APIFY_TOKEN=your_apify_token
# Actor id or "user~actor-name" slug of the social-media-finder actor
APIFY_ACTOR_ID=your_actor_id
# Optional JSON input template. May use {name} and {website} placeholders.
# Defaults to '{"name": "{name}"}' when unset.
APIFY_ACTOR_INPUT={"name": "{name}"}
# Optional sync-run timeout in seconds (default 120)
APIFY_TIMEOUT_SECONDS=120

# ── Serper.dev (fallback search for platforms Apify/Wikidata do not cover) ──
SERPER_API_KEY=your_serper_key

# ── Frontend CORS (comma-separated origins for production) ──
# Example: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
