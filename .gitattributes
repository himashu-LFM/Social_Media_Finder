# Files that are executed on Linux must keep LF endings. Checked out on Windows
# with CRLF, a shell script fails with "bad interpreter: /usr/bin/env bash^M"
# and a systemd unit is rejected outright — both errors point nowhere useful.
*.sh            text eol=lf
*.service       text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
deploy/Caddyfile text eol=lf
